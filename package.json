{
  "name": "discord-auto-server-platform",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.16.0",
    "npm": "10.9.2"
  },
  "scripts": {
    "dev": "tsx apps/platform/src/index.ts",
    "dev:dashboard": "vite --config apps/dashboard/vite.config.ts",
    "build": "npm run build:platform && npm run build:dashboard",
    "build:platform": "tsup apps/platform/src/index.ts --format esm --platform node --target node22 --out-dir apps/platform/dist --sourcemap --clean",
    "build:dashboard": "vite build --config apps/dashboard/vite.config.ts",
    "start": "node apps/platform/dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx scripts/migrate.ts",
    "register:commands": "tsx scripts/register-commands.ts",
    "generate:assets": "tsx scripts/generate-assets.ts",
    "canon:audit": "node --experimental-strip-types scripts/canon-audit.mjs",
    "test:domain-smoke": "node --experimental-transform-types scripts/domain-smoke.mjs",
    "test:fault-model": "node --experimental-transform-types scripts/fault-model-smoke.mjs",
    "release:readiness": "node --experimental-transform-types scripts/release-readiness.mjs",
    "release:gate": "npm run test:toolchain-policy && npm run test:workflow-supply-chain && npm run test:source-syntax && node --experimental-transform-types scripts/release-readiness.mjs --enforce",
    "generate:file-manifest": "node scripts/generate-file-manifest.mjs",
    "generate:docs": "node scripts/generate-docs.mjs",
    "test:stress-model": "node --experimental-transform-types scripts/stress-model-smoke.mjs",
    "test:a11y-i18n": "node --experimental-transform-types scripts/a11y-i18n-smoke.mjs",
    "test:ui-v2": "node --experimental-transform-types scripts/ui-v2-smoke.mjs",
    "test:live-db": "tsx scripts/live-db-gate.ts",
    "test:live-discord": "tsx scripts/live-discord-gate.ts",
    "release:manifest": "node scripts/release-manifest.mjs",
    "release:sbom": "mkdir -p artifacts && npm sbom --sbom-format cyclonedx > artifacts/sbom.cdx.json",
    "security:plugin-isolation-probe": "node --experimental-transform-types scripts/plugin-isolation-probe.mjs",
    "release:provenance": "node scripts/release-provenance.mjs",
    "generate:requirement-traceability": "node scripts/requirement-traceability.mjs --write",
    "test:traceability": "node scripts/requirement-traceability.mjs --check",
    "test:project-truth": "node scripts/project-truth-audit.mjs",
    "test:external-ai": "node --experimental-transform-types scripts/external-ai-contract-smoke.mjs",
    "test:data-governance": "node --experimental-transform-types scripts/data-governance-contract-smoke.mjs",
    "test:audit-integrity": "node --experimental-transform-types scripts/audit-integrity-contract-smoke.mjs",
    "test:backup-restore-evidence": "node --experimental-transform-types scripts/backup-restore-evidence-contract-smoke.mjs",
    "test:phase17-completion": "node --experimental-transform-types scripts/phase17-completion-smoke.mjs",
    "security:plugin-isolation-gate": "node --experimental-transform-types scripts/plugin-isolation-probe.mjs --enforce",
    "test:phase18-plugin-sandbox": "node --experimental-transform-types scripts/phase18-plugin-sandbox-smoke.mjs",
    "test:live-http": "node scripts/live-http-gate.mjs",
    "test:live-http-self": "node scripts/live-http-gate.mjs --self-test",
    "test:live-browser": "node scripts/live-browser-gate.mjs",
    "test:live-browser-self": "node scripts/live-browser-gate.mjs --self-test",
    "test:live-harness-self": "npm run test:live-http-self && npm run test:live-browser-self",
    "test:phase18-live-qa": "node scripts/phase18-live-qa-smoke.mjs",
    "test:dependency-policy": "node --experimental-transform-types scripts/dependency-policy-contract-smoke.mjs",
    "dependency:lock-policy": "node --experimental-transform-types scripts/dependency-lock-gate.mjs",
    "release:dependency-lock-gate": "node --experimental-transform-types scripts/dependency-lock-gate.mjs --enforce",
    "dependency:bootstrap-lock": "node --experimental-transform-types scripts/bootstrap-dependency-lock.mjs",
    "test:phase19-dependency-admission": "node --experimental-transform-types scripts/phase19-dependency-admission-smoke.mjs",
    "test:source-syntax": "node scripts/source-syntax-gate.mjs --require-typescript",
    "test:phase20-source-integrity": "node scripts/phase20-source-integrity-smoke.mjs",
    "test:offline-preflight": "node scripts/offline-release-preflight.mjs",
    "test:phase21-release-provenance": "node scripts/phase21-release-provenance-smoke.mjs",
    "test:workflow-supply-chain": "node --experimental-transform-types scripts/workflow-supply-chain-gate.mjs --enforce",
    "test:phase22-workflow-supply-chain": "node scripts/phase22-workflow-supply-chain-smoke.mjs",
    "test:phase23-experience-expansion": "node --experimental-transform-types scripts/phase23-experience-expansion-smoke.mjs",
    "test:phase24-session-reliability-slo": "node --experimental-transform-types scripts/phase24-session-reliability-slo-smoke.mjs",
    "test:toolchain-policy": "node --experimental-transform-types scripts/toolchain-policy-gate.mjs --enforce",
    "test:phase25-final-closure": "node --experimental-transform-types scripts/phase25-final-closure-smoke.mjs",
    "final:attest": "node --experimental-transform-types scripts/final-source-attestation.mjs",
    "test:config-surface": "node scripts/config-surface-audit.mjs",
    "test:phase26-final-stabilization": "node --experimental-transform-types scripts/phase26-final-stabilization-smoke.mjs",
    "test:setup-surface": "node scripts/setup-surface-audit.mjs",
    "test:phase27-visual-experience": "node --experimental-transform-types scripts/phase27-visual-experience-smoke.mjs",
    "test:phase28-extreme-overhaul": "node --experimental-transform-types scripts/phase28-extreme-overhaul-smoke.mjs",
    "test:thai-presentation": "node --experimental-transform-types scripts/thai-presentation-audit.mjs",
    "test:phase29-production-intelligence": "node --experimental-transform-types scripts/phase29-production-intelligence-smoke.mjs",
    "test:phase29-chaos-replay": "node --experimental-transform-types scripts/phase29-chaos-replay-smoke.mjs"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/websocket": "11.3.0",
    "@supabase/supabase-js": "2.110.8",
    "discord.js": "14.22.1",
    "fastify": "5.11.0",
    "lucide-react": "1.28.0",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "tsx": "4.23.1",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.10",
    "@types/ws": "8.18.1"
  },
  "packageManager": "npm@10.9.2"
}
