NODE_ENV=development
PORT=10000
LOG_LEVEL=info
PROCESS_ROLE=all
PUBLIC_BASE_URL=http://localhost:10000
DASHBOARD_URL=http://localhost:5173
DASHBOARD_ORIGIN=http://localhost:5173

# Discord (required to enable bot)
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=http://localhost:10000/api/auth/callback
DASHBOARD_SESSION_SECRET=
DISCORD_TEST_GUILD_ID=
BOT_ENABLED=false
# Enable in Discord Developer Portal only when Welcome/Member lifecycle automation is needed.
DISCORD_GUILD_MEMBERS_INTENT=false
# Sharding stays single-process by default. Use auto only when Discord scale requires it; manual needs IDs + total count.
DISCORD_SHARD_MODE=single
DISCORD_SHARD_IDS=
DISCORD_SHARD_COUNT=

# Durable persistence. Recommended free profile: Supabase Postgres connection string.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Bounded Postgres pool/query timeouts; tune only after observing pool waiting pressure.
DATABASE_POOL_MAX=8
DATABASE_CONNECT_TIMEOUT_MS=8000
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_QUERY_TIMEOUT_MS=35000

# Protect admin HTTP mutations. Generate a long random value.
ADMIN_API_KEY=
INTERACTION_SIGNING_SECRET=

# Optional durable free asset storage (Supabase Storage). Server-side secret only; never expose to dashboard/browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback for existing Supabase projects; prefer SUPABASE_SECRET_KEY for new deployments.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=autoserver-assets

# Runtime behavior
AUTO_RUN_MIGRATIONS=true
JOB_POLL_INTERVAL_MS=1200
JOB_LEASE_SECONDS=30
MAX_GUILD_MUTATION_CONCURRENCY=1
ASSET_OUTPUT_DIR=.tmp/assets

# Durable scheduler claim loop (scheduled tasks, not a replacement for Discord events)
SCHEDULER_POLL_INTERVAL_MS=15000
SHUTDOWN_GRACE_MS=25000

# External plugins are disabled by default. THIRD_PARTY requires the explicit Linux namespace/seccomp profile and a passing deployment probe.
# LINUX_NS_SECCOMP_V1 is Linux x86_64 only and still requires deployment-level cgroup/RSS controls for hostile-code production use.
PLUGIN_ROOT=plugins/external
EXTERNAL_PLUGINS_ENABLED=false
THIRD_PARTY_PLUGINS_ENABLED=false
THIRD_PARTY_PLUGIN_SANDBOX_PROFILE=DISABLED
PLUGIN_SANDBOX_HEAP_MB=384
PLUGIN_SANDBOX_TMP_MB=8
PLUGIN_TIMEOUT_MS=5000
PLUGIN_MAX_OUTPUT_BYTES=262144

# Optional external AI provider. Disabled by default; local-rules remains the zero-cost default.
# Enabling OpenAI requires explicit provider enablement, model, capability allowlist and data-class allowlist.
# Keep SECRET out of the data-class allowlist. Dashboard external-AI calls also require live guild management permission.
AI_EXTERNAL_PROVIDERS_ENABLED=false
OPENAI_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_AI_MODEL=
OPENAI_AI_ALLOWED_CAPABILITIES=
OPENAI_AI_ALLOWED_DATA_CLASSES=
OPENAI_AI_MAX_INPUT_BYTES=16384
